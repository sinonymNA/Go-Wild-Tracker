# =====================================================================
# GoWild Radar — Environment Variables
# Copy this file to .env for local development
# =====================================================================

# Required — set before starting
ADMIN_PASSWORD=changeme

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be stable across restarts or sessions will be invalidated
SECRET_KEY=change-me-to-a-random-string

# Database
# Local dev default (SQLite — no setup required):
DATABASE_URL=sqlite:///./gowild.db
# Railway PostgreSQL (set automatically by Railway when you add a Postgres plugin):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Scraper mode
# true  = safe mode (fake data, no browser launched, dashboard works immediately)
# false = real mode (launches Playwright, scrapes Frontier — tune selectors first)
MOCK_MODE=true

# App settings (can also be changed in the Settings UI)
HOME_AIRPORT=ATL
SCAN_INTERVAL_MINUTES=60
MAX_ROUTES_PER_SCAN=10
DELAY_BETWEEN_SEARCHES_SECONDS=5
SCAN_DATES_AHEAD=14

# Browser settings (for real mode)
HEADLESS=true
DEBUG_SCREENSHOTS=false

# Alerts (optional)
DISCORD_WEBHOOK_URL=

# Port (Railway injects this automatically)
PORT=8000
